DATABASE_URL=postgresql://creatorforge:creatorforge@localhost:5432/creatorforge
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:3000"]

# Powers the AI Script Assistant (POST /scripts/generate). Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Powers the AI Audio Studio's voiceover generator (POST /audio/voiceover).
# Get a key from your account settings at https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
